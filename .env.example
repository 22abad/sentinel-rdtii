# Optional cloud-provider API keys. The default Ollama Quick Start needs none.
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Active provider: ollama / gemini / claude / openai / deepseek / groq / llama3
RDTII_LLM_PROVIDER=ollama

# Optional fallback provider (judge-safety net). Enable this only when its API
# key is configured; leaving it blank preserves the no-key Ollama Quick Start.
# RDTII_LLM_FALLBACK_PROVIDER=deepseek
RDTII_LLM_FALLBACK_PROVIDER=

# Optional model overrides
# GEMINI_MODEL=gemini-2.0-flash
# CLAUDE_MODEL=claude-sonnet-4-6
# DEEPSEEK_MODEL=deepseek-v4-flash

# --- Cost accounting -------------------------------------------------------
# The per-provider fallback prices compiled into providers/openai_compatible.py
# are an OLD list-price snapshot kept only so a run reports *something*. Any
# cost figure you intend to quote must come from these envs, set to the rates
# on your billing dashboard. USD per 1M tokens.
# DEEPSEEK_INPUT_USD_PER_MTOK=
# DEEPSEEK_OUTPUT_USD_PER_MTOK=
# Prefix-cache hits are billed far below a miss. Leave unset and every input
# token is priced at the miss rate — safe, but it overstates the bill: a
# measured run on deepseek-v4-flash serves ~95% of its input tokens from cache
# (identical rules/schema preamble, only the article text changes per chunk).
# DEEPSEEK_CACHE_HIT_USD_PER_MTOK=
# OPENAI_CACHE_HIT_USD_PER_MTOK=

# --- Analyst rationale pass (DEFAULT: on) -----------------------------------
# One extra LLM call per ACCEPTED mapping, ~a third of a run's calls. It writes
# the official "Mapping Rationale" column and nothing else; no score depends on
# it. Setting this to "off" therefore CHANGES A SUBMITTED COLUMN: the cell falls
# back to the terse deterministic scorer sentence. A run with it off prints a
# warning saying so. Leave it ON for anything you intend to submit;
# tools/run_round2_eval.py turns it off for itself (it compares deterministic
# scores and never reads the column) and takes --with-analyst to restore it.
# RDTII_ANALYST=off

# Embedding backend for the web app's vector store (No Vendor Lock-in).
# local  = open-weight sentence-transformers, offline, no key (default)
# gemini = Google free-tier text-embedding-004 (needs GOOGLE_API_KEY; online)
# Note: backends embed into different dimensions — re-embed the corpus when switching.
EMBEDDING_PROVIDER=local
GOOGLE_API_KEY=

# Local open-weight model via Ollama (No Vendor Lock-in — no API key needed).
# These defaults match the README Quick Start. From inside Docker, change the
# base URL to http://host.docker.internal:11434/v1.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b

# Database (defaults match docker-compose)
POSTGRES_DB=rdtii
POSTGRES_USER=rdtii_user
POSTGRES_PASSWORD=rdtii_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rdtii_user:rdtii_password@localhost:5433/rdtii
DB_CONNECT_TIMEOUT_SECONDS=5

# Extract sidecar internal auth
EXTRACT_SIDECAR_URL=http://localhost:4000
SIDECAR_API_KEY=dev-sidecar-secret
SIDECAR_ADDR=0.0.0.0:4000

# CORS
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Local demo only: set true to skip the frontend login guard
VITE_AUTH_BYPASS=false
VITE_DISCOVERY_SEARCH_TIMEOUT_MS=60000

# Live-discovery cost guardrail: cap extraction on oversized live-discovered
# documents (chars). Seeds and --pdf documents are never capped. 0 disables.
# Affected rows carry an honest "partial doc" note.
RDTII_MAX_LIVE_DOC_CHARS=150000

# Discovery live search backend.
#   Leave ALL blank -> free DuckDuckGo web search (no key, no signup, no quota).
#     This is the recommended zero-config default for reviewers. DDG can
#     bot-challenge an IP after many rapid searches; a keyed backend below
#     avoids that.
#   Set SERPAPI_API_KEY (free tier at serpapi.com) -> Google-backed results,
#     auto-selected when a key is present. Marginally broader.
#   Set GOOGLE_CSE_KEY + GOOGLE_CSE_ID -> Google's official Custom Search API
#     (100 queries/day free). Setup: enable "Custom Search API" at
#     console.cloud.google.com, create an engine with "Search the entire web"
#     at cse.google.com. Auto-selected when both are present and no SerpApi key.
#   DISCOVERY_SEARCH_BACKEND=none -> disable live web search (local library only).
# Dedicated official-portal adapters (Australia, China, etc.) run regardless and
# need no search backend or key.
DISCOVERY_SEARCH_BACKEND=
SERPAPI_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
