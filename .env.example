# Optional cloud-provider API keys. The default Ollama Quick Start needs none.
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Active provider: ollama / gemini / claude / openai / deepseek / groq / llama3
RDTII_LLM_PROVIDER=ollama

# Fallback provider (judge-safety net). If the primary above is unavailable in a
# reviewer's environment (e.g. Ollama not installed) or a request errors, the run
# transparently fails over to this provider. Ship a DeepSeek key so the tool
# always completes. Leave blank to disable failover. Must differ from the primary.
RDTII_LLM_FALLBACK_PROVIDER=deepseek

# Optional model overrides
# GEMINI_MODEL=gemini-2.0-flash
# CLAUDE_MODEL=claude-sonnet-4-20250514
# DEEPSEEK_MODEL=deepseek-v4-flash

# Local open-weight model via Ollama (No Vendor Lock-in — no API key needed).
# These defaults match the README Quick Start. From inside Docker, change the
# base URL to http://host.docker.internal:11434/v1.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b

# Database (defaults match docker-compose)
POSTGRES_DB=rdtii
POSTGRES_USER=rdtii_user
POSTGRES_PASSWORD=rdtii_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rdtii_user:rdtii_password@localhost:5433/rdtii
DB_CONNECT_TIMEOUT_SECONDS=5

# Extract sidecar internal auth
EXTRACT_SIDECAR_URL=http://localhost:4000
SIDECAR_API_KEY=dev-sidecar-secret
SIDECAR_ADDR=0.0.0.0:4000

# CORS
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Local demo only: set true to skip the frontend login guard
VITE_AUTH_BYPASS=false
VITE_DISCOVERY_SEARCH_TIMEOUT_MS=60000

# Optional Discovery live search backend.
# Leave blank for fixture fallback; set both values to enable generic live search.
DISCOVERY_SEARCH_BACKEND=
SERPAPI_API_KEY=
